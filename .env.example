# Canlı site adresi (Iyzico callback için zorunlu)
APP_URL=https://senin-domainin.com

# JWT oturum. Canlıda mutlaka değiştir.
AUTH_SECRET=uzun-rastgele-bir-gizli-anahtar

# Railway volume mount (ör. /data). Yoksa ./data kullanılır.
DATA_DIR=/data

# Iyzico — sandbox: https://sandbox-merchant.iyzipay.com
# Canlı: IYZI_MODE=live ve canlı anahtarlar
IYZI_API_KEY=
IYZI_SECRET_KEY=
IYZI_MODE=sandbox
# IYZI_BASE_URL=https://sandbox-api.iyzipay.com
